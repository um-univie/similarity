from typing import Optional, Sequence, Tuple

import numpy as np
import numpy.typing as npt

FloatArray = npt.NDArray[np.float64] | npt.NDArray[np.float32]
F64 = npt.NDArray[np.float64]
Spectrum = Tuple[F64, F64]
Hits = Tuple[npt.NDArray[np.uintp], F64]

__version__: str

def isa() -> str: ...
def dense_backend() -> str: ...
def distance(a: FloatArray, b: FloatArray, metric: str = "cosine") -> float: ...
def cdist(a: FloatArray, b: FloatArray, metric: str = "euclidean") -> FloatArray: ...
def pdist(x: FloatArray, metric: str = "euclidean") -> FloatArray: ...
def top_k(query: FloatArray, x: FloatArray, k: int, metric: str = "cosine") -> Tuple[npt.NDArray[np.uintp], FloatArray]: ...
def shannon_entropy(x: F64) -> Optional[float]: ...
def kl_divergence(p: F64, q: F64) -> Optional[float]: ...
def cross_entropy(p: F64, q: F64) -> Optional[float]: ...
def js_divergence(p: F64, q: F64) -> Optional[float]: ...
def js_distance(p: F64, q: F64) -> Optional[float]: ...
def hellinger_distance(p: F64, q: F64) -> Optional[float]: ...
def bhattacharyya_distance(p: F64, q: F64) -> Optional[float]: ...
def total_variation_distance(p: F64, q: F64) -> Optional[float]: ...
def entropy_similarity(
    mz_a: F64, intensity_a: F64, mz_b: F64, intensity_b: F64, tolerance: float = 0.01, ppm: bool = False
) -> float: ...
def spectral_cosine(
    mz_a: F64,
    intensity_a: F64,
    mz_b: F64,
    intensity_b: F64,
    tolerance: float = 0.01,
    ppm: bool = False,
    mz_power: float = 0.0,
    intensity_power: float = 1.0,
) -> Tuple[float, int]: ...

class FlashEntropyIndex:
    def __init__(
        self,
        spectra: Sequence[Spectrum],
        tolerance: float = 0.01,
        ppm: bool = False,
        weighted: bool = True,
        noise_fraction: float = 0.0,
        max_peaks: Optional[int] = None,
    ) -> None: ...
    def __len__(self) -> int: ...
    @property
    def n_peaks(self) -> int: ...
    def search(self, mz: F64, intensity: F64) -> F64: ...
    def search_top_k(self, mz: F64, intensity: F64, k: int) -> Hits: ...
    def search_many(self, queries: Sequence[Spectrum], k: int) -> list[Hits]: ...

class SpectralLibrary:
    def __init__(
        self,
        spectra: Sequence[Spectrum],
        precursor_mz: Optional[F64] = None,
        metric: str = "entropy",
        tolerance: float = 0.01,
        ppm: bool = False,
        precursor_tolerance: Optional[float] = None,
        precursor_ppm: bool = False,
        mz_power: float = 0.0,
        intensity_power: float = 1.0,
        min_matched_peaks: int = 1,
        min_score: float = 0.0,
        noise_fraction: float = 0.0,
        max_peaks: Optional[int] = None,
    ) -> None: ...
    def __len__(self) -> int: ...
    def search(
        self, mz: F64, intensity: F64, precursor_mz: Optional[float] = None, k: int = 0
    ) -> list[Tuple[int, float, int]]: ...
    def search_many(
        self, queries: Sequence[Spectrum], precursor_mz: Optional[F64] = None, k: int = 0
    ) -> list[list[Tuple[int, float, int]]]: ...
    def similarity_matrix(self) -> F64: ...
